{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "spark-forge-azure",
  "version": "0.3.3",
  "cli": "sparkforge-azure",
  "cli_entry": "sparkforge_azure.cli.main:main",
  "workflows": [
    {
      "id": "analyze",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "analyze",
        "{target}"
      ],
      "description": "Analyze Azure data artifacts",
      "read_only": true
    },
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "doctor"
      ],
      "description": "Environment health",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [
    "adf-specialist",
    "adls-specialist",
    "analyzer",
    "azure-databricks-specialist",
    "bicep-specialist",
    "coordinator",
    "cosmos-db-specialist",
    "cost-reviewer",
    "critic",
    "databricks-cost-reviewer",
    "databricks-performance-reviewer",
    "databricks-runtime-reviewer",
    "databricks-uc-reviewer",
    "delta-specialist",
    "entra-specialist",
    "evaluation-specialist",
    "event-hubs-specialist",
    "extractor",
    "fabric-specialist",
    "finops-specialist",
    "iceberg-specialist",
    "inventory",
    "judge",
    "migration-reviewer",
    "migration-specialist",
    "networking-specialist",
    "observability-specialist",
    "onelake-specialist",
    "performance-reviewer",
    "purview-specialist",
    "referee",
    "reviewer",
    "security-reviewer",
    "spark-performance-specialist",
    "streaming-specialist",
    "synapse-specialist",
    "synthesizer",
    "terraform-specialist",
    "test-engineer",
    "unity-catalog-specialist",
    "verifier"
  ],
  "coordinators": [],
  "mcp_command": [
    "{cli}",
    "mcp",
    "serve"
  ],
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "requires_network": false,
  "requires_credentials": false,
  "read_only_default": true
}
