{
  "forge_id": "spark-forge-azure",
  "package": "sparkforge_azure",
  "distribution": "sparkforge-azure",
  "cli": "sparkforge-azure",
  "python": ">=3.10",
  "mcp_server_name": "sparkforge-azure",
  "mcp_command": [
    "sparkforge-azure",
    "mcp",
    "serve"
  ],
  "extras": [
    "mcp"
  ],
  "lab": {
    "command": [
      "{checkout}/.venv/bin/python",
      "scripts/lab/sparkforge_azure_lab.py",
      "--checkout",
      "{checkout}",
      "--mode",
      "{mode}",
      "--result-out",
      "{receipt}"
    ],
    "receipt": ".forge/lab-result.json",
    "modes": [
      "A"
    ],
    "suite": "spark-forge-azure-lab",
    "timeout_s": 120
  }
}
